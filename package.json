{
  "name": "vscode-gitattributes",
  "displayName": "gitattributes",
  "description": "A simple extension that lets you pull .gitattributes files from https://github.com/alexkaratarakis/gitattributes and create a combined .gitattributes file.",
  "version": "0.4.2",
  "publisher": "nekoboinick",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#008080"
  },
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/thakyZ/vscode-gitattributes"
  },
  "bugs": {
    "url": "https://github.com/thakyZ/vscode-gitattributes/issues"
  },
  "homepage": "https://github.com/thakyZ/vscode-gitattributes",
  "license": "MIT",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "addgitattributes",
        "title": "Add .gitattributes"
      }
    ],
    "configuration": {
      "title": "gitattributes extension configuration",
      "properties": {
        "gitattributes.cacheExpirationInterval": {
          "type": "integer",
          "default": "86400",
          "description": "Number of seconds the list of `.gitattributes` files retrieved from GitHub will be cached"
        },
        "gitattributes.token": {
          "type": "string",
          "default": "",
          "description": "Token for api access."
        }
      }
    },
    "languages": [
      {
        "id": "gitattributes",
        "aliases": [
          "Gitattributes"
        ],
        "filenames": [
          ".gitattributes"
        ],
        "configuration": "./gitattributes.configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gitattributes",
        "scopeName": "text.gitattributes",
        "path": "./syntaxes/gitattributes.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@octokit/openapi-types": "^24.2.0",
    "@octokit/rest": "^21.1.1",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@stylistic/eslint-plugin-js": "^4.2.0",
    "@stylistic/eslint-plugin-ts": "^4.2.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.14",
    "@types/vscode": "^1.98.0",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.23.0",
    "eslint-plugin-unicorn": "^58.0.0",
    "glob": "^11.0.1",
    "mocha": "^11.1.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@vscode/vsce": "^3.3.1"
  },
  "__metadata": {
    "publisherDisplayName": "Neko Boi Nick"
  }
}
